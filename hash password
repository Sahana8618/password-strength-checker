import string
import time
import itertools
import hashlib

# -------------------------------
# PASSWORD STRENGTH ANALYZER
# -------------------------------

password = input("Enter a password to test: ")

length = len(password)
has_upper = any(c.isupper() for c in password)
has_lower = any(c.islower() for c in password)
has_digit = any(c.isdigit() for c in password)
has_symbol = any(c in string.punctuation for c in password)

score = 0
if length >= 8: score += 1
if has_upper: score += 1
if has_lower: score += 1
if has_digit: score += 1
if has_symbol: score += 1

if score <= 2:
    strength = "WEAK"
elif score <= 4:
    strength = "MEDIUM"
else:
    strength = "STRONG"

print("\nPassword Strength:", strength)

# -------------------------------
# PASSWORD HASHING (SHA-256)
# -------------------------------

def hash_password(pwd):
    return hashlib.sha256(pwd.encode()).hexdigest()

stored_hash = hash_password(password)
print("Password stored securely using hashing.")

# -------------------------------
# LOGIN SIMULATION
# -------------------------------

login_pwd = input("\nEnter password to login: ")
login_hash = hash_password(login_pwd)

if login_hash == stored_hash:
    print("Login Successful ✅")
else:
    print("Login Failed ❌")

# -------------------------------
# BRUTE-FORCE ATTACK SIMULATION
# -------------------------------

def brute_force_attack(target_hash, max_length=3):
    characters = string.ascii_lowercase + string.digits
    attempts = 0
    start_time = time.time()

    print("\nBrute-force attack started...")

    for length in range(1, max_length + 1):
        for guess in itertools.product(characters, repeat=length):
            attempts += 1
            guess = ''.join(guess)

            if hash_password(guess) == target_hash:
                end_time = time.time()
                print("\nPassword Cracked!")
                print("Cracked Password:", guess)
                print("Total Attempts:", attempts)
                print("Time Taken:", round(end_time - start_time, 2), "seconds")
                return

    print("\nPassword not cracked (limit reached).")

# -------------------------------
# USER CONSENT FOR ATTACK
# -------------------------------

choice = input("\nRun brute-force attack simulation? (yes/no): ")

if choice.lower() == "yes":
    brute_force_attack(stored_hash)
else:
    print("Brute-force simulation skipped.")
